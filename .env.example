# ============================================
# ENVIRONMENT VARIABLES CONFIGURATION
# ============================================
# 
# You can set these variables in two ways:
# 1. Create a .env file (for local development)
# 2. Set them in Coolify UI (for production)
#    - Go to your resource in Coolify
#    - Click "Environment Variables"
#    - Add each variable below
#
# REQUIRED VARIABLES:
# These must be set for the application to work properly
# ============================================

# Ghost CMS Configuration
GHOST_URL=https://cms.finarena.pl
GHOST_CONTENT_API_KEY=your_ghost_api_key_here

# Site Configuration (Public - used during build and runtime)
NEXT_PUBLIC_SITE_URL=https://finarena.pl
NEXT_PUBLIC_SITE_NAME=Finarena

# Contact Form (Nodemailer z Gmail)
# GMAIL_USER to twój adres e-mail (np. kamiltonkowicz@gmail.com) uzywany do autoryzacji Google (logowania)
GMAIL_USER=kamil.tonkowicz@finarena.pl
# GMAIL_APP_PASSWORD to specjalne hasło aplikacji wygenerowane w ustawieniach Google dla konta wyżej
GMAIL_APP_PASSWORD=zefqealbtieooneg
# GMAIL_RECEIVER (Opcjonalnie) jeśli chcesz wysyłać i odbierać zapytania używając autoryzowanego aliasu konta
GMAIL_RECEIVER=kontakt@finarena.pl
# GMAIL_SENDER_NAME (Opcjonalnie) jeśli chcesz nadpisać wyświetlaną nazwę nadawcy w formularzu ("Finarena Formularz" jako domyślna)
GMAIL_SENDER_NAME="Kontakt Finarena"
# ============================================
# COOLIFY DEPLOYMENT NOTES:
# ============================================
# 
# 1. Build-time variables (NEXT_PUBLIC_*):
#    - These are embedded during the Docker build
#    - If you change them in Coolify, you need to redeploy
# 
# 2. Runtime variables (GHOST_URL, GHOST_CONTENT_API_KEY):
#    - These can be changed in Coolify without rebuilding
#    - They are read when the container starts
#
# 3. To check if variables are loaded:
#    - Visit /api/health endpoint
#    - Check container logs in Coolify
#
